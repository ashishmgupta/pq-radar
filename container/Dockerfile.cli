FROM ubuntu:25.10

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY probe.py scan.py ./

# So `docker run image target1 target2 ...` passes args straight to the scanner
ENTRYPOINT ["python3", "scan.py"]
