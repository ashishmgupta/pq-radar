# Dependencies
node_modules/

# Wrangler local state/cache
.wrangler/

# Local secrets / environment — never commit real credentials
.dev.vars
.env
creds.txt
wrangler.local.jsonc

# Python container bytecode cache
**/__pycache__/
*.pyc

# Stray scratch/debug output
_scale_check.json

# CLI scan inputs/outputs — real hostnames and raw handshake data from
# whatever you point the standalone scanner at, never safe to publish.
# Wildcarded on both sides since --out naming isn't consistent
# (report.html, subnet-report.html, lpl-subdomains-report.html, ...).
*.subdomains.txt
lpl-subdomains.txt
*report*.json
*report*.html

# Local-only, never checked in — kept out of the public repo on request
docs/voice-chat-brief.html

# OS/editor cruft
.DS_Store
